# Secrets — never commit
.env

# Secret files for Nautobot's "text file" provider (see secrets/README.md).
# Only the README is tracked; every other file in there is a secret value.
secrets/*
!secrets/README.md

# Generated by setup.sh from requirements-{major}.x.txt
requirements.txt

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Docker
docker-compose.override.yml
# Per-deployment artifacts referenced from docker-compose.override.prod.yml.example
Caddyfile

# Firmware server — generated/real TLS material (never commit keys or certs)
firmware/certs/*
!firmware/certs/.gitkeep

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
.claude/
*.swp
*.swo
*~

# Backups
backups/
*.sql
*.sql.gz
*.tar.gz
