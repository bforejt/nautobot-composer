# =============================================================================
# Nautobot Docker Compose — Environment Variables
# =============================================================================
# This file documents all available environment variables with their defaults.
# Run ./setup.sh to generate a .env file with random secrets automatically.
#
# To create .env manually instead:
#   cp env.example .env
#   # Then fill in NAUTOBOT_SECRET_KEY, passwords, and API token.
# =============================================================================

# ---------------------------------------------------------------------------
# Compose Profiles — opt-in add-on services
# ---------------------------------------------------------------------------

# Comma-separated list of Compose profiles to activate.  Compose reads this
# file for EVERY 'docker compose' command run in this directory, so this is
# the persistent switch that makes add-on services part of the stack: they
# start with a plain 'docker compose up -d', come back after a reboot, and
# are started/stopped by the optional systemd unit.
# Available profiles:
#   gitlab          — GitLab CE server (see README: GitLab)
#   firmware        — firmware file server: Filebrowser UI + nginx download
#                     endpoint (see README: Firmware server)
#   answer-service  — bare-metal Proxmox install engine for nautobot-proxmox
#                     (see README: Answer Service)
#   tacacs          — TACACS+ device AAA: tac_plus-ng + AD users + Nautobot-
#                     rendered device inventory (see README: TACACS+ Server)
# Manage via './setup.sh --with-<profile>' (e.g. --with-gitlab
# --with-tacacs; remove with the matching --without-* flags), or edit
# this line directly.
# One-off alternative that does NOT persist: docker compose --profile gitlab up -d
COMPOSE_PROFILES=

# ---------------------------------------------------------------------------
# Nautobot Core
# ---------------------------------------------------------------------------

# Deployment tier — gates destructive operations.  Allowed values:
#   lab        — default; reset.sh, load-test-data.sh, restore.sh proceed with
#                their normal confirmation prompts.
#   staging    — reset.sh and load-test-data.sh REFUSE without
#                --allow-production-destroy.  restore.sh requires you to
#                type the env name to confirm.
#   production — same as staging, but with the env name 'production'.
# Change this from 'lab' to 'production' once you've pivoted this deployment
# beyond lab use.  Setup.sh writes it as 'lab' for fresh installs.
NAUTOBOT_ENV=lab

# Image tag for the upstream Nautobot base image.  Read at build time as
# a docker compose build-arg.  Set or changed via 'setup.sh -v <version>'.
# Examples: 3.1-py3.12, 3.0-py3.12, 2.4-py3.12.
#NAUTOBOT_VERSION=3.1-py3.12

# Django secret key — must be unique per deployment. Auto-generated by setup.sh.
# Generate manually: python3 -c "from secrets import token_urlsafe; print(token_urlsafe(64))"
#NAUTOBOT_SECRET_KEY=

# Comma-separated list of hostnames/IPs that Nautobot will respond to.
# Use '*' for development; set to your FQDN(s) in production.
NAUTOBOT_ALLOWED_HOSTS=*

# Subnet for this project's Docker network.  Pins the stack to a fixed,
# non-conflicting range instead of letting Docker auto-carve a /16 from its
# default pool (172.17/16, 172.18/16, ...), which can clash with company
# address space.  Default: 192.0.2.0/24 (RFC 5737 TEST-NET-1, reserved for
# documentation — should never appear in real routing).  Docker picks the
# gateway (.1) automatically; ~254 hosts is ample for this stack.  Changing
# this on a running stack needs 'docker compose down && up -d' (see README:
# Networking).
NAUTOBOT_NETWORK_SUBNET=192.0.2.0/24

# Set to True only for development/debugging.
NAUTOBOT_DEBUG=False

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
NAUTOBOT_LOG_LEVEL=INFO

# Expose Prometheus metrics at /metrics
NAUTOBOT_METRICS_ENABLED=True

# Unlimited API page size (0 = no limit)
NAUTOBOT_MAX_PAGE_SIZE=0

# Hide UI elements the user doesn't have permission to access.
NAUTOBOT_HIDE_RESTRICTED_UI=True

# Opt out of anonymous installation metrics.
NAUTOBOT_INSTALLATION_METRICS_ENABLED=False

# ---------------------------------------------------------------------------
# PostgreSQL Database
# ---------------------------------------------------------------------------
POSTGRES_DB=nautobot
POSTGRES_USER=nautobot
# Auto-generated by setup.sh. Set a strong password if creating .env manually.
#POSTGRES_PASSWORD=

# NAUTOBOT_DB_* must match the POSTGRES_* values above.
NAUTOBOT_DB_NAME=nautobot
NAUTOBOT_DB_USER=nautobot
NAUTOBOT_DB_HOST=db
NAUTOBOT_DB_PORT=5432
NAUTOBOT_DB_ENGINE=django.db.backends.postgresql

# ---------------------------------------------------------------------------
# Valkey (Redis-compatible)
# The env vars keep the NAUTOBOT_REDIS_* / REDIS_ prefix because that's what
# Nautobot, django-redis, and Celery expect.  The server is Valkey under the
# hood (see docker-compose.yml), but the protocol is identical.
# ---------------------------------------------------------------------------
NAUTOBOT_REDIS_HOST=redis
NAUTOBOT_REDIS_PORT=6379
NAUTOBOT_REDIS_PASSWORD=
NAUTOBOT_REDIS_SSL=False

# Redis memory cap.  Accepts Redis-style sizes: 512mb, 1gb, 2gb, etc.
# Cache entries are evicted via allkeys-lru when the cap is reached.
REDIS_MAXMEMORY=512mb

# ---------------------------------------------------------------------------
# Superuser — Created on First Start
# ---------------------------------------------------------------------------
# Set NAUTOBOT_CREATE_SUPERUSER=true to auto-create an admin account.
NAUTOBOT_CREATE_SUPERUSER=true
NAUTOBOT_SUPERUSER_NAME=admin
NAUTOBOT_SUPERUSER_EMAIL=admin@example.com
# Auto-generated by setup.sh. Set manually if not using setup.sh.
#NAUTOBOT_SUPERUSER_PASSWORD=
#NAUTOBOT_SUPERUSER_API_TOKEN=

# ---------------------------------------------------------------------------
# NAPALM (optional — used by some Apps for device interaction)
# ---------------------------------------------------------------------------
NAPALM_USERNAME=
NAPALM_PASSWORD=
NAPALM_TIMEOUT=30

# ---------------------------------------------------------------------------
# Celery
# ---------------------------------------------------------------------------
# By default Celery uses the same Redis instance as caching.
# Override only if you need a separate broker:
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Firmware Server (optional add-on — Compose profile: firmware)
# ---------------------------------------------------------------------------
# A two-service file host for network-device firmware images:
#   * an authenticated Filebrowser web UI for engineers (upload/manage), and
#   * a read-only, network-restricted nginx endpoint for device pulls.
# Enable it with the "firmware" Compose profile (it does not start by default):
#   docker compose --profile firmware up -d
# These variables are unused unless that profile is active, so they are safe to
# leave at their defaults until you turn the firmware server on.

# Host interface to bind ALL firmware ports to.  0.0.0.0 = all interfaces.
# For tighter control, set to a specific management-interface IP so only that
# interface accepts connections (the strongest restriction — Docker's NAT can
# mask the real client IP, weakening nginx allow/deny on published ports).
FIRMWARE_BIND_ADDRESS=0.0.0.0

# Host port for the authenticated Filebrowser management UI (humans).
FIRMWARE_FILEBROWSER_PORT=8088

# Host ports for the device-facing download endpoint (unauthenticated).
# HTTP is the DEFAULT device transfer path: device HTTPS clients (e.g.
# IOS-XE `copy https:`) validate the server certificate against their
# trustpoints and reject the self-signed cert this stack generates, so
# HTTPS only works once a CA-issued cert the devices trust is installed
# (see README: TLS).  Both listeners are always on.
# HTTP uses the protocol-default port 80: some consumers of these URLs
# cannot specify a port.  The Nautobot web service gave up its plain-HTTP
# 80 mapping to free this (the UI is HTTPS-only on 443).  If you use the
# production Caddy overlay (which also binds host 80), move this to a free
# port or pin FIRMWARE_BIND_ADDRESS to a dedicated interface IP.
FIRMWARE_HTTPS_PORT=9443
FIRMWARE_HTTP_PORT=80

# Legacy HTTP port, published alongside FIRMWARE_HTTP_PORT for backward
# compatibility: download_urls registered in Nautobot before the port-80
# move embed :9080 and keep working through this mapping.  Same nginx
# listener, same content.  Harmless to leave on; to retire it, set this
# equal to FIRMWARE_HTTP_PORT (the duplicate publish collapses into one).
# Keep this line PRESENT even when moving FIRMWARE_HTTP_PORT off 80 (e.g.
# the Caddy overlay): the compose default for this variable is 80, so
# leaving it unset would publish 80 anyway and collide with Caddy.
FIRMWARE_HTTP_LEGACY_PORT=9080

# Hostname/IP that appears in device download URLs and in the auto-generated
# self-signed certificate's CN/SAN.  Must be reachable from BOTH the device
# management network AND the Nautobot worker (which validates images).
# Keep this in sync with the host in FIRMWARE_BASE_URL below — setup.sh sets
# both to the host's primary IP.  In a lab, use the IP (devices rarely
# resolve lab DNS names).
FIRMWARE_SERVER_NAME=localhost

# Device-facing base URL for firmware downloads — the DEFAULT the Register
# job stores in SoftwareImageFile.download_url as <base>/<filename>.  Not
# used by the firmware containers themselves — .env is the env_file for
# every Nautobot container, so this reaches the Celery worker where the
# companion nautobot-upgrades "Register IOS-XE Image" job reads it.
# Plain HTTP on FIRMWARE_HTTP_PORT by default: device TLS clients reject
# the self-signed cert (see the port comment above).
# Must be reachable FROM THE DEVICES (use the host's IP in a lab), with the
# host kept in sync with FIRMWARE_SERVER_NAME.
# setup.sh fills this automatically from the host's primary IP (taken from
# the routing table — never DNS or `hostname`); override with
# './setup.sh --firmware-url <url>' or edit here.  Empty = the Register job
# requires a per-run URL instead of guessing one devices can't reach.
# The port is omitted when FIRMWARE_HTTP_PORT is 80 (the default).
# Example: http://192.0.2.10/images/
FIRMWARE_BASE_URL=

# HTTPS variant of the base URL, kept alongside so the Register job can
# store an https download_url for a single run via its "use HTTPS URL"
# option (sensible once a CA-issued cert the devices trust is installed).
# setup.sh fills it from the same host and FIRMWARE_HTTPS_PORT.
# Example: https://192.0.2.10:9443/images/
FIRMWARE_BASE_URL_HTTPS=

# URL the Celery worker uses to VALIDATE images (reachability/size checks).
# Defaults inside the Register job to the internal Docker route
# http://firmware-download/images/ which always works from the worker —
# normally leave this unset.
#FIRMWARE_INTERNAL_URL=

# Comma- or whitespace-separated CIDRs allowed to pull from the device
# endpoint (nginx allow/deny).  0.0.0.0/0 = allow all (rely on host firewall /
# VLAN ACL).  Tighten to your device-management subnet(s), e.g.
#   FIRMWARE_ALLOWED_CIDRS=10.20.30.0/24,10.20.40.0/24
FIRMWARE_ALLOWED_CIDRS=0.0.0.0/0

# Filebrowser admin credentials for the management UI.  NEVER hard-coded in
# compose — sourced here.  setup.sh auto-generates the password; set it
# manually if you create .env by hand.
FIRMWARE_ADMIN_USER=admin
#FIRMWARE_ADMIN_PASSWORD=

# --- NFV Answer Service (profile: answer-service) ---------------------------
# `setup.sh --with-answer-service` prepares this add-on: it generates the TLS
# keypair + fingerprint (below), a root password hash, and warns if the sibling
# nautobot-proxmox build context is missing.  You still MUST set the two
# operator-supplied values below — the service refuses to start without them
# (the answer-service-preflight one-shot fails `up` with a clear message).
#
# Nautobot API token the answer service authenticates with (device lookups,
# Secret/SecretsGroup creation, provisioning_state write-back).
ANSWER_NAUTOBOT_TOKEN=
# How INSTALLING NODES reach the service — a LAN address, never localhost,
# e.g. https://10.20.30.40:8800.  Left empty on purpose: the preflight only
# checks it is non-empty, so a pre-filled placeholder would slip past it.
ANSWER_PUBLIC_URL=
# SHA256 fingerprint of answer-service/certs/answer-service.crt.  setup.sh
# --with-answer-service generates the keypair and writes this to match; pass
# the same value to prepare-install-iso.sh --fingerprint for installer media.
ANSWER_CERT_FINGERPRINT=
# Optional overrides:
#ANSWER_SERVICE_BUILD_CONTEXT=../nautobot-proxmox/bmc
#ANSWER_BIND_ADDRESS=0.0.0.0
#ANSWER_PORT=8800
#ANSWER_DOMAIN=nfv.lab
#ANSWER_TIMEZONE=America/Chicago

# --- TACACS+ Server (profile: tacacs) ---------------------------------------
# Device AAA via tac_plus-ng (RFC 8907, TCP/49).  Users authenticate against
# Active Directory; device inventory and per-device keys are authored in
# Nautobot and rendered into the daemon config.  See README: TACACS+ Server.
# All variables below are unused unless the tacacs profile is active.

# Default TACACS+ shared key for devices without a per-device secret file.
# RFC 8907 §10.5.1: servers must support keys of at least 32 chars; setup.sh
# generates 32.
#TACACS_DEFAULT_KEY=

# Keep a catch-all client entry (any source IP, default key).  REQUIRED where
# Docker's published-port NAT masks real device IPs (always on Docker
# Desktop).  Set to false on hosts where real client IPs reach the container
# to enforce RFC 8907 §10.5.2 per-device allow-listing instead.
TACACS_OPEN_DEFAULT=true

# --- Active Directory (users) ---
# Space-separated LDAP URL(s) of your domain controllers.  LDAPS strongly
# recommended — the MAVIS backend binds AS THE USER, so credentials transit
# this connection.  Empty = AD backend disabled (only the internal loopback
# healthcheck user can authenticate; devices get "permission denied").
#TACACS_AD_URLS=ldaps://dc1.example.local:636 ldaps://dc2.example.local:636
TACACS_AD_URLS=
# Search base and (optional) bind account for user/group lookups.
#TACACS_AD_BASE_DN=dc=example,dc=local
TACACS_AD_BASE_DN=
#TACACS_AD_BIND_DN=cn=svc-tacacs,ou=Service Accounts,dc=example,dc=local
TACACS_AD_BIND_DN=
TACACS_AD_BIND_PASSWORD=

# AD security groups mapped to device privilege (nested membership resolved):
#   admin    -> priv-lvl 15, enable = AD login password
#   readonly -> priv-lvl 1
TACACS_ADMIN_GROUP=
TACACS_READONLY_GROUP=

# --- Nautobot-driven device inventory (renderer) ---
# Nautobot API token for the render loop (read-only device access is enough).
# Empty = renderer idle; the daemon serves the static seed config.
TACACS_NAUTOBOT_TOKEN=
# Devices carrying this Nautobot tag are rendered as TACACS+ clients, keyed by
# primary IPv4.  Per-device secrets: ./secrets/tacacs/<device-name>.key (the
# file a Nautobot Secret object of provider "text file" points at); devices
# without one use TACACS_DEFAULT_KEY.
TACACS_DEVICE_TAG=tacacs
# Seconds between Nautobot reconciliation runs (min 30).
TACACS_RENDER_INTERVAL=300
# Days of date-bucketed accounting/access logs to keep in the volume (0 = keep
# all; the render loop prunes older buckets).
TACACS_LOG_RETENTION_DAYS=30

# Optional overrides:
#TACACS_BIND_ADDRESS=0.0.0.0
#TACACS_PORT=49
